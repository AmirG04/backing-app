# Copia este archivo a ".env" (en la raiz del proyecto, junto a
# docker-compose.yml) y completa los valores reales.
#
# NUNCA subas el archivo ".env" real a git (ya esta en .gitignore).

# ---------------------------------------------------------------------
# Variables que SI se leen desde este archivo .env
# ---------------------------------------------------------------------

# Requerida solo para el chat con IA (POST /api/chat).
# El resto del proyecto (auth, cuentas, transacciones, frontend) funciona
# perfectamente sin esta variable.
#
# Consiguela en https://openrouter.ai (crea una cuenta -> API Keys).
OPENROUTER_API_KEY=

# Opcional. Cualquier modelo del catalogo de OpenRouter que soporte
# "tool calling" (ver https://openrouter.ai/models). Si se deja vacio,
# se usa "anthropic/claude-sonnet-4.5" por defecto.
OPENROUTER_MODEL=

# ---------------------------------------------------------------------
# Referencia: otras variables que usa el backend (internal/config/config.go)
# Estas NO se leen de este archivo - ya vienen fijas en docker-compose.yml
# para que "docker compose up" funcione sin configuracion adicional.
# Se documentan aqui solo para saber que existen y donde cambiarlas.
# ---------------------------------------------------------------------
#
# PORT                    - puerto del backend (docker-compose.yml: "8080")
# DATABASE_URL             - cadena de conexion a Postgres
# TIGERBEETLE_ADDRESS      - IP:puerto del servidor TigerBeetle (172.28.0.10:3000)
# TIGERBEETLE_CLUSTER_ID   - ID de cluster de TigerBeetle ("0")
# JWT_SECRET               - clave para firmar los tokens JWT
#                            (cambiar en un entorno real, no solo pruebas)
